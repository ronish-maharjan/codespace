{
  "name": "Linux PC",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }
  },

  "forwardPorts": [6080],

  "portsAttributes": {
    "6080": {
      "label": "Linux Desktop",
      "protocol": "http"
    }
  },

  "postStartCommand": "bash .devcontainer/start-gui.sh"
}
